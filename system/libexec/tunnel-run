#!/bin/sh
# Lance le tunnel Cloudflare qui expose Syntax Connect sur Internet.
if /usr/bin/syntax has-default-password; then
    echo "Tunnel bloqué : un compte utilise encore le mot de passe d'usine." >&2
    exit 1
fi
if [ -s /etc/syntax/tunnel.token ]; then
    TUNNEL_TOKEN="$(cat /etc/syntax/tunnel.token)"
    export TUNNEL_TOKEN
    exec cloudflared --no-autoupdate tunnel run
elif [ -s /etc/syntax/cloudflared/config.yml ]; then
    exec cloudflared --no-autoupdate tunnel --config /etc/syntax/cloudflared/config.yml run
fi
echo "Aucun tunnel configuré."
exit 0
