#!/usr/bin/env python3
"""Réglages Syntax — clavier, fond d'écran, comptes, mise à jour, dock, diagnostic
Bluetooth, à propos. Une page web locale (même langage visuel que Syntax Connect),
affichée dans une fenêtre dédiée plutôt qu'un panneau générique.

Les réglages avancés et spécifiques au matériel (overclock, caméra, GPIO…) restent
accessibles via « Configuration Raspberry Pi (avancé) » dans le lanceur — on ne les
duplique pas ici.
"""
import html
import http.server
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import urllib.parse

WALLPAPER_DIR = "/usr/share/syntax/wallpapers"
LOCK_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "syntax-settings.pid")

KEYBOARDS = [("fr", "Français (AZERTY)"), ("gb", "Anglais (QWERTY)"), ("ch", "Suisse"), ("be", "Belge")]


def toggle_close_if_running():
    try:
        with open(LOCK_FILE, encoding="utf-8") as f:
            pid = int(f.read().strip())
        os.kill(pid, signal.SIGTERM)
        os.remove(LOCK_FILE)
        return True
    except (OSError, ValueError):
        try:
            os.remove(LOCK_FILE)
        except OSError:
            pass
        return False


def list_wallpapers():
    try:
        return sorted(f for f in os.listdir(WALLPAPER_DIR) if f.lower().endswith((".jpg", ".jpeg", ".png")))
    except OSError:
        return []


def run_privileged(action, arg):
    return subprocess.run(
        ["pkexec", "/usr/lib/syntax/libexec/syntax-settings-apply", action, arg],
        capture_output=True, text=True,
    )


def bluetooth_diagnostic():
    out = []
    out.append("=== systemctl status bluetooth ===")
    out.append(subprocess.run(["systemctl", "status", "bluetooth", "--no-pager"],
                               capture_output=True, text=True).stdout)
    devices = subprocess.run(["bluetoothctl", "devices"], capture_output=True, text=True).stdout
    out.append("=== bluetoothctl devices ===")
    out.append(devices)
    for line in devices.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            mac = parts[1]
            out.append(f"=== bluetoothctl info {mac} ===")
            out.append(subprocess.run(["bluetoothctl", "info", mac], capture_output=True, text=True).stdout)
    out.append("=== journalctl -u bluetooth (lignes HID/input) ===")
    j = subprocess.run(["journalctl", "-u", "bluetooth", "--no-pager", "-n", "300"],
                        capture_output=True, text=True).stdout
    out.append("\n".join(l for l in j.splitlines() if any(k in l.lower() for k in ("hid", "input", "hog")))[-4000:])
    return "\n".join(out)


PAGE = """<!doctype html>
<html><head><meta charset="utf-8"><title>Réglages Syntax</title>
<link rel="stylesheet" href="http://localhost/static/style.css">
<style>
