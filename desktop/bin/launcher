#!/usr/bin/env python3
"""Lanceur Syntax (touche Super, ou clic sur le logo du dock) : une seule fenêtre avec
les applications récentes, toutes les applications installées, et Marche/Arrêt — comme
le menu Démarrer de Windows. Un second appel la referme.

Limite honnête : fuzzel (le moteur de ce menu) affiche ce menu en liste texte filtrable,
pas une grille d'icônes avec aperçus ; les entrées récentes et Marche/Arrêt apparaissent
en haut de la même liste plutôt que dans des zones séparées visuellement.
"""
import importlib.util
import os
import subprocess
import sys

DOCK_EDIT = "/usr/lib/syntax/desktop/dock-edit.py"
RECENT_FILE = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "syntax-launcher-recent",
)
MAX_RECENT = 6
POWER = [
    ("Marche/Arrêt…", "lxsession-logout"),
    ("Changer d'utilisateur", "dm-tool switch-to-greeter"),
]


def load_app_scanner():
    spec = importlib.util.spec_from_file_location("syntax_dock_edit", DOCK_EDIT)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def load_recent():
    try:
        with open(RECENT_FILE, encoding="utf-8") as f:
            return [line.strip() for line in f if line.strip()]
    except OSError:
        return []


def save_recent(name):
    names = [name] + [n for n in load_recent() if n != name]
    try:
        os.makedirs(os.path.dirname(RECENT_FILE), exist_ok=True)
        with open(RECENT_FILE, "w", encoding="utf-8") as f:
            f.write("\n".join(names[:MAX_RECENT]))
    except OSError:
        pass


def already_open():
    return subprocess.run(["pkill", "-x", "fuzzel"]).returncode == 0


def main():
    if already_open():
        return

    try:
        dock_edit = load_app_scanner()
        by_name = {}
        for info in dock_edit.all_apps().values():
            by_name.setdefault(info["name"], info["exec"])
    except Exception:
        by_name = {}

    recent = [n for n in load_recent() if n in by_name]

    lines, line_cmd, line_app = [], {}, set()
    for n in recent:
        label = f"Récent : {n}"
        lines.append(label)
        line_cmd[label] = by_name[n]
        line_app.add(label)
    for label, cmd in POWER:
        lines.append(label)
        line_cmd[label] = cmd
    for name in sorted(by_name):
        lines.append(name)
        line_cmd[name] = by_name[name]
        line_app.add(name)

    try:
        proc = subprocess.run(
            ["fuzzel", "--dmenu", "--config=/usr/share/syntax/desktop/fuzzel.ini",
             "--prompt=Syntax  "],
            input="\n".join(lines), capture_output=True, text=True,
        )
    except FileNotFoundError:
        return

    choice = proc.stdout.strip()
    if not choice or choice not in line_cmd:
        return
    subprocess.Popen(["sh", "-c", line_cmd[choice]], start_new_session=True)
    if choice in line_app:
        save_recent(choice[len("Récent : "):] if choice.startswith("Récent : ") else choice)


if __name__ == "__main__":
    main()
