#!/usr/bin/env python3
"""Réglages du dock de Syntax OS : taille des icônes, applications épinglées, ordre
— avec un vrai glisser-déposer pour réorganiser la liste (contrairement au dock
lui-même : waybar, la barre qui l'affiche, n'a pas cette capacité ; voir le README).
Même page web locale que Réglages Syntax et le menu Démarrer.
"""
import importlib.util
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import urllib.parse
import http.server

DOCK_EDIT = "/usr/lib/syntax/desktop/dock-edit.py"
DOCK_CONF = os.environ.get("SYNTAX_DOCK_CONF", "/etc/syntax-dock.json")
LOCK_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "syntax-dockset.pid")
ICON_DIRS = ["/usr/share/icons/Papirus/64x64/apps", "/usr/share/icons/Papirus/48x48/apps",
             "/usr/share/icons/hicolor/scalable/apps", "/usr/share/icons/hicolor/256x256/apps",
             "/usr/share/icons/hicolor/128x128/apps", "/usr/share/icons/hicolor/48x48/apps",
             "/usr/share/pixmaps"]
SIZES = [28, 38, 50, 64]


def load_dock_edit():
    spec = importlib.util.spec_from_file_location("syntax_dock_edit", DOCK_EDIT)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def resolve_icon(name):
    if not name:
        return None
    if name.startswith("/"):
        return name if os.path.exists(name) else None
    for d in ICON_DIRS:
        for ext in ("svg", "png"):
            p = os.path.join(d, f"{name}.{ext}")
            if os.path.exists(p):
                return p
    return None


def toggle_close_if_running():
    try:
        with open(LOCK_FILE, encoding="utf-8") as f:
            pid = int(f.read().strip())
        os.kill(pid, signal.SIGTERM)
        os.remove(LOCK_FILE)
        return True
    except (OSError, ValueError):
        try:
            os.remove(LOCK_FILE)
        except OSError:
            pass
        return False


PAGE = """<!doctype html>
<html><head><meta charset="utf-8"><title>Réglages du dock</title>
<link rel="stylesheet" href="http://localhost/static/style.css">
<meta name="color-scheme" content="light">
<style>
:root{
  --bg:#f3f1ec!important; --card:#ffffff!important; --text:#17191b!important; --muted:#6c6560!important;
  --line:#ddd7cc!important; --accent:#e05a28!important; --accent-text:#ffffff!important;
  --field:#ffffff!important; --shadow:0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.06)!important;
}
html,body{margin:0;height:100%;overflow:hidden}
body{background:var(--bg);color:var(--text);display:flex;flex-direction:column;height:100vh}
.ds-bar{display:flex;align-items:center;gap:10px;padding:16px 20px;border-bottom:1px solid var(--line)}
.ds-bar h1{font-size:17px;margin:0}
.ds-body{flex:1;overflow-y:auto;padding:18px 20px 28px;display:grid;gap:18px;align-content:start;max-width:520px}
.ds-sizes{display:flex;gap:8px}
.ds-sizes button{flex:1;padding:10px 8px;font-size:12.5px}
.ds-sizes button.on{background:var(--accent);color:var(--accent-text)}
.ds-list{display:grid;gap:6px}
.ds-item{
  display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--line);
  border-radius:12px;padding:8px 10px;cursor:grab;box-shadow:var(--shadow);
}
.ds-item.dragging{opacity:.4}
.ds-item.dragover{border-color:var(--accent)}
.ds-item .handle{color:var(--muted);font-size:16px;line-height:1;user-select:none}
.ds-item img{width:24px;height:24px;object-fit:contain;flex:none}
.ds-item .fallback{width:24px;height:24px;border-radius:6px;background:var(--accent);flex:none}
.ds-item span{font-size:13.5px;flex:1}
.ds-item button{background:none;color:var(--muted);padding:4px 8px;font-size:12px}
.ds-item button:hover{color:var(--danger)}
.ds-add{display:grid;gap:6px;max-height:220px;overflow-y:auto;border:1px solid var(--line);
        border-radius:12px;padding:8px}
.ds-add-row{display:flex;align-items:center;gap:10px;padding:6px 8px;border-radius:9px;cursor:pointer}
.ds-add-row:hover{background:color-mix(in srgb, var(--muted) 10%, transparent)}
.ds-add-row img{width:20px;height:20px;object-fit:contain}
.ds-hint{font-size:12.5px;color:var(--muted)}
</style></head>
<body>
  <div class="ds-bar">
    <img src="/usr/share/syntax/logo.svg" style="width:26px;height:26px" onerror="this.style.display='none'">
    <h1>Réglages du dock</h1>
  </div>
  <div class="ds-body">
    <div>
      <h3>Taille des icônes</h3>
      <div class="ds-sizes" id="sizes"></div>
    </div>
    <div>
      <h3>Épinglées — glisse pour réorganiser</h3>
      <p class="ds-hint">Clique le ✕ pour retirer une icône.</p>
      <div class="ds-list" id="list"></div>
    </div>
    <div>
      <h3>Ajouter une application</h3>
      <div class="ds-add" id="available"></div>
    </div>
  </div>
<script>
let ITEMS = __ITEMS_JSON__;
const AVAILABLE = __AVAILABLE_JSON__;
let SIZE = __SIZE_JSON__;

function iconHtml(icon, name){
  return icon ? `<img src="/icon?p=${encodeURIComponent(icon)}">`
               : `<div class="fallback"></div>`;
}

function save(){
  fetch("/save", {method:"POST", headers:{"Content-Type":"application/json"},
    body: JSON.stringify({icon_size: SIZE, items: ITEMS})});
}

function renderSizes(){
  const el = document.getElementById("sizes");
  el.innerHTML = "";
  const labels = {28:"Petite", 38:"Moyenne", 50:"Grande", 64:"Très grande"};
  for (const s of [28,38,50,64]){
    const b = document.createElement("button");
    b.textContent = labels[s];
    if (s === SIZE) b.classList.add("on");
    b.onclick = () => { SIZE = s; renderSizes(); save(); };
    el.appendChild(b);
  }
}

let dragIndex = null;
function renderList(){
  const el = document.getElementById("list");
  el.innerHTML = "";
  ITEMS.forEach((item, i) => {
    const row = document.createElement("div");
    row.className = "ds-item";
    row.draggable = true;
    row.innerHTML = `<span class="handle">⠿</span>${iconHtml(item.icon, item.label)}<span>${item.label}</span><button>✕</button>`;
    row.querySelector("button").onclick = () => { ITEMS.splice(i,1); renderList(); renderAvailable(); save(); };
    row.addEventListener("dragstart", () => { dragIndex = i; row.classList.add("dragging"); });
    row.addEventListener("dragend", () => { row.classList.remove("dragging"); renderList(); });
    row.addEventListener("dragover", e => { e.preventDefault(); row.classList.add("dragover"); });
    row.addEventListener("dragleave", () => row.classList.remove("dragover"));
    row.addEventListener("drop", e => {
      e.preventDefault(); row.classList.remove("dragover");
      if (dragIndex === null || dragIndex === i) return;
      const [moved] = ITEMS.splice(dragIndex, 1);
      ITEMS.splice(i, 0, moved);
      dragIndex = null;
      renderList(); save();
    });
    el.appendChild(row);
  });
}

function renderAvailable(){
  const el = document.getElementById("available");
  el.innerHTML = "";
  const pinnedExecs = new Set(ITEMS.map(i => i.exec));
  const avail = AVAILABLE.filter(a => !pinnedExecs.has(a.exec));
  if (!avail.length){ el.innerHTML = '<p class="ds-hint" style="padding:6px 8px">Toutes les applications sont déjà épinglées.</p>'; return; }
  avail.forEach(a => {
    const row = document.createElement("div");
    row.className = "ds-add-row";
    row.innerHTML = iconHtml(a.icon, a.name) + `<span>${a.name}</span>`;
    row.onclick = () => {
      ITEMS.push({id: a.id, label: a.name, exec: a.exec, icon: a.icon || ""});
      renderList(); renderAvailable(); save();
    };
    el.appendChild(row);
  });
}

renderSizes();
renderList();
renderAvailable();
</script>
</body></html>
"""


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/":
            self._page()
        elif parsed.path == "/icon":
            self._icon(urllib.parse.parse_qs(parsed.query).get("p", [""])[0])
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        if self.path != "/save":
            self.send_response(404)
            self.end_headers()
            return
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length)
        try:
            conf = json.loads(body)
            conf["icon_size"] = max(22, min(72, int(conf.get("icon_size", 38))))
            conf["items"] = [
                {"id": it["id"], "label": it["label"], "exec": it["exec"], "icon": it.get("icon", "")}
                for it in conf.get("items", [])
            ]
        except (ValueError, KeyError, TypeError):
            self.send_response(400)
            self.end_headers()
            return
        self.server.pending_conf = conf
        self.send_response(204)
        self.end_headers()

    def _page(self):
        dock_edit = load_dock_edit()
        conf = dock_edit.load(DOCK_CONF)
        apps = dock_edit.all_apps()
        exec_to_icon = {info["exec"]: info["icon"] for info in apps.values()}
        items = [{
            "id": it["id"], "label": it.get("label", it["id"]), "exec": it["exec"],
            "icon": resolve_icon(it.get("icon") or exec_to_icon.get(it["exec"])),
        } for it in conf["items"]]
        available = [{
            "id": base, "name": info["name"], "exec": info["exec"],
            "icon": resolve_icon(info["icon"]),
        } for base, info in sorted(apps.items(), key=lambda kv: kv[1]["name"].lower())]
        page = (PAGE
                .replace("__ITEMS_JSON__", json.dumps(items))
                .replace("__AVAILABLE_JSON__", json.dumps(available))
                .replace("__SIZE_JSON__", json.dumps(conf["icon_size"])))
        body = page.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _icon(self, path):
        if not path or not os.path.isfile(path) or not path.startswith(tuple(ICON_DIRS) + ("/usr/share/syntax",)):
            self.send_response(404)
            self.end_headers()
            return
        ctype = "image/svg+xml" if path.endswith(".svg") else "image/png"
        with open(path, "rb") as f:
            data = f.read()
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def free_port():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def apply_conf(conf):
    tmp = f"/tmp/syntax-dock-{os.getpid()}.json"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(conf, f, ensure_ascii=False)
    try:
        subprocess.run(["pkexec", "/usr/lib/syntax/libexec/dock-apply", tmp], check=False)
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass


def main():
    if toggle_close_if_running():
        return
    os.makedirs(os.path.dirname(LOCK_FILE), exist_ok=True)
    with open(LOCK_FILE, "w", encoding="utf-8") as f:
        f.write(str(os.getpid()))

    def cleanup(*_a):
        try:
            os.remove(LOCK_FILE)
        except OSError:
            pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)

    port = free_port()
    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    server.pending_conf = None
    threading.Thread(target=server.serve_forever, daemon=True).start()

    browser = None
    for b in ("google-chrome", "chromium", "chromium-browser"):
        if subprocess.run(["sh", "-c", f"command -v {b}"], capture_output=True).returncode == 0:
            browser = b
            break
    if not browser:
        cleanup()
        return

    proc = subprocess.Popen([
        browser, f"--app=http://127.0.0.1:{port}/",
        "--class=syntax-dock-settings", "--window-size=560,760",
        "--disable-extensions", "--no-first-run",
    ])
    proc.wait()

    if server.pending_conf is not None:
        apply_conf(server.pending_conf)

    cleanup()


if __name__ == "__main__":
    main()
