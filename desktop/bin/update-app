#!/bin/sh
# Mise à jour de Syntax OS — fenêtre native, lançable depuis le dock.
ICON=/usr/share/syntax/logo.png
LOG="$(mktemp /tmp/syntax-update-XXXX.log)"

zenity --question --title="Mise à jour Syntax OS" --window-icon="$ICON" \
    --text="Vérifier et installer les mises à jour maintenant ?\n\nPaquets du système et fichiers Syntax OS. Peut prendre plusieurs minutes." \
    --width=380 --ok-label="Mettre à jour" --cancel-label="Annuler" || exit 0

pkexec /usr/lib/syntax/selfupdate.sh > "$LOG" 2>&1 &
PID=$!

( tail -n +1 -f "$LOG" & TAILPID=$!
  while kill -0 "$PID" 2>/dev/null; do sleep 0.5; done
  kill "$TAILPID" 2>/dev/null ) | \
    zenity --text-info --title="Mise à jour Syntax OS" --window-icon="$ICON" \
        --width=560 --height=380 --ok-label="Fermer" &
ZPID=$!

wait "$PID"
RC=$?
kill "$ZPID" 2>/dev/null

if [ "$RC" -eq 0 ]; then
    zenity --info --title="Mise à jour Syntax OS" --window-icon="$ICON" --width=380 \
        --text="Mise à jour terminée. Le Pi va redémarrer dans quelques secondes pour l'appliquer entièrement.\n\n$(tail -4 "$LOG")"
else
    zenity --error --title="Mise à jour Syntax OS" --window-icon="$ICON" --width=380 \
        --text="La mise à jour a échoué (ou l'autorisation a été refusée).\n\nDétails : $LOG"
fi
