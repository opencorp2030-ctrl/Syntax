window.active.indicator.toggled-keybind.color: #6e62ff
window.active.title.bg.color: #1d1d21
window.inactive.title.bg.color: #19191c
window.active.label.text.color: #f5f5f7
window.inactive.label.text.color: #7c7c84

window.button.width: 26
window.button.height: 22
window.button.spacing: 4
window.button.hover.bg.corner-radius: 11
window.active.button.unpressed.image.color: #d1d1d6
window.inactive.button.unpressed.image.color: #5c5c64
window.active.button.hover.bg.color: #ffffff22
window.inactive.button.hover.bg.color: #ffffff18

window.active.shadow.size: 46
window.inactive.shadow.size: 30
window.active.shadow.color: #00000070
window.inactive.shadow.color: #00000040

